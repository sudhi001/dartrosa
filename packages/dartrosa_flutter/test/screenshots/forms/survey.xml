<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa">
  <h:head>
    <h:title>Household survey</h:title>
    <model>
      <instance>
        <data id="catalog-survey">
          <name/>
          <age/>
          <children>
            <has_children/>
            <count/>
            <in_school/>
          </children>
          <visit_date/>
          <contact>
            <phone/>
            <village/>
            <landmark/>
            <best_time/>
            <notes/>
            <callback/>
          </contact>
          <member jr:template="">
            <member_name/>
          </member>
          <thanks/>
        </data>
      </instance>
      <bind nodeset="/data/name" type="string" required="true()" jr:requiredMsg="Please enter the respondent's name."/>
      <bind nodeset="/data/age" type="int" required="true()" constraint=". &gt;= 0 and . &lt;= 120" jr:constraintMsg="Age must be between 0 and 120."/>
      <bind nodeset="/data/children/has_children" type="string" required="true()"/>
      <bind nodeset="/data/children/count" type="int" relevant="/data/children/has_children = 'yes'" required="true()" constraint=". &gt; 0" jr:constraintMsg="Enter at least 1."/>
      <bind nodeset="/data/children/in_school" type="string" relevant="/data/children/has_children = 'yes'"/>
      <bind nodeset="/data/visit_date" type="date" constraint=". &lt;= today()" jr:constraintMsg="The visit can't be in the future."/>
      <bind nodeset="/data/contact/phone" type="string" required="true()" constraint="string-length(.) = 10" jr:constraintMsg="A phone number has 10 digits." jr:requiredMsg="Enter a phone number."/>
      <bind nodeset="/data/contact/village" type="string" required="true()" jr:requiredMsg="Enter the village."/>
      <bind nodeset="/data/contact/landmark" type="string"/>
      <bind nodeset="/data/contact/best_time" type="string"/>
      <bind nodeset="/data/contact/notes" type="string"/>
      <bind nodeset="/data/contact/callback" type="string" required="true()" jr:requiredMsg="Ask whether we may call back."/>
      <bind nodeset="/data/member/member_name" type="string"/>
      <bind nodeset="/data/thanks" type="string" readonly="true()"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/name">
      <label>What is the respondent's name?</label>
    </input>
    <input ref="/data/age">
      <label>How old is <output value="/data/name"/>?</label>
      <hint>In completed years.</hint>
    </input>
    <group ref="/data/children" appearance="field-list">
      <label>Children</label>
      <select1 ref="/data/children/has_children" appearance="columns-pack">
        <label>Do you have children under 18?</label>
        <item><label>Yes</label><value>yes</value></item>
        <item><label>No</label><value>no</value></item>
      </select1>
      <input ref="/data/children/count" appearance="counter">
        <label>How many?</label>
      </input>
      <select ref="/data/children/in_school">
        <label>Which levels do they attend?</label>
        <item><label>Primary</label><value>primary</value></item>
        <item><label>Secondary</label><value>secondary</value></item>
        <item><label>None yet</label><value>none</value></item>
      </select>
    </group>
    <input ref="/data/visit_date">
      <label>Date of the visit</label>
    </input>
    <group ref="/data/contact" appearance="field-list">
      <label>Contact details</label>
      <input ref="/data/contact/phone" appearance="numbers">
        <label>Phone number</label>
      </input>
      <input ref="/data/contact/village">
        <label>Village</label>
      </input>
      <input ref="/data/contact/landmark">
        <label>Nearest landmark</label>
      </input>
      <select1 ref="/data/contact/best_time">
        <label>Best time to call</label>
        <item><label>Morning</label><value>morning</value></item>
        <item><label>Afternoon</label><value>afternoon</value></item>
        <item><label>Evening</label><value>evening</value></item>
      </select1>
      <input ref="/data/contact/notes" appearance="multiline">
        <label>Directions to the house</label>
      </input>
      <select1 ref="/data/contact/callback" appearance="columns-pack">
        <label>May we call back?</label>
        <item><label>Yes</label><value>yes</value></item>
        <item><label>No</label><value>no</value></item>
      </select1>
    </group>
    <group ref="/data/member">
      <label>Household member</label>
      <repeat nodeset="/data/member">
        <input ref="/data/member/member_name">
          <label>Name of the household member</label>
        </input>
      </repeat>
    </group>
    <input ref="/data/thanks">
      <label>Thank you. Check the answers in the outline, then finalize.</label>
    </input>
  </h:body>
</h:html>
