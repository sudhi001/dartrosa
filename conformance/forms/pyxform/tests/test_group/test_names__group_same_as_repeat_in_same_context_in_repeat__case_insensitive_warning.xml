<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <test_name id="data">
          <r1 jr:template="">
            <g2 jr:template="">
              <q1/>
            </g2>
            <G2>
              <q2/>
            </G2>
          </r1>
          <r1>
            <g2>
              <q1/>
            </g2>
            <G2>
              <q2/>
            </G2>
          </r1>
          <meta>
            <instanceID/>
          </meta>
        </test_name>
      </instance>
      <bind nodeset="/test_name/r1/g2/q1" type="string"/>
      <bind nodeset="/test_name/r1/G2/q2" type="string"/>
      <bind nodeset="/test_name/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group ref="/test_name/r1">
      <label>R1</label>
      <repeat nodeset="/test_name/r1">
        <group ref="/test_name/r1/g2">
          <label>G2</label>
          <repeat nodeset="/test_name/r1/g2">
            <input ref="/test_name/r1/g2/q1">
              <label>Q1</label>
            </input>
          </repeat>
        </group>
        <group ref="/test_name/r1/G2">
          <label>G2</label>
          <input ref="/test_name/r1/G2/q2">
            <label>Q2</label>
          </input>
        </group>
      </repeat>
    </group>
  </h:body>
</h:html>
