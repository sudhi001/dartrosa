<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <trigger-column id="data">
          <rep jr:template="">
            <one/>
            <three/>
          </rep>
          <rep>
            <one/>
            <three/>
          </rep>
          <meta>
            <instanceID/>
          </meta>
        </trigger-column>
      </instance>
      <bind nodeset="/trigger-column/rep/one" type="dateTime"/>
      <bind nodeset="/trigger-column/rep/three" type="dateTime"/>
      <bind nodeset="/trigger-column/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group ref="/trigger-column/rep">
      <label/>
      <repeat nodeset="/trigger-column/rep">
        <input ref="/trigger-column/rep/one">
          <label>Enter text</label>
          <setvalue ref="/trigger-column/rep/three" event="xforms-value-changed" value="string-length( ../one )"/>
        </input>
        <input ref="/trigger-column/rep/three">
          <label>Enter text (triggered)</label>
        </input>
      </repeat>
    </group>
  </h:body>
</h:html>
