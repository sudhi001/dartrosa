<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Duplicates</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="en">
          <text id="list-0">
            <value>Pass</value>
          </text>
          <text id="list-1">
            <value>Fail</value>
          </text>
          <text id="list-2">
            <value>Skipped</value>
          </text>
          <text id="list-3">
            <value>Not Applicable</value>
          </text>
          <text id="/test_name/S1:label">
            <value>s1</value>
          </text>
        </translation>
        <translation lang="ko">
          <text id="list-0">
            <value>패스</value>
          </text>
          <text id="list-1">
            <value>실패</value>
          </text>
          <text id="list-2">
            <value>건너뛴</value>
          </text>
          <text id="list-3">
            <value>해당 없음</value>
          </text>
          <text id="/test_name/S1:label">
            <value>질문 1</value>
          </text>
        </translation>
      </itext>
      <instance>
        <test_name id="Duplicates">
          <S1/>
          <meta>
            <instanceID/>
          </meta>
        </test_name>
      </instance>
      <instance id="list">
        <root>
          <item>
            <itextId>list-0</itextId>
            <name>a</name>
          </item>
          <item>
            <itextId>list-1</itextId>
            <name>b</name>
          </item>
          <item>
            <itextId>list-2</itextId>
            <name>c</name>
          </item>
          <item>
            <itextId>list-3</itextId>
            <name>c</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/test_name/S1" type="string"/>
      <bind nodeset="/test_name/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <select1 ref="/test_name/S1">
      <label ref="jr:itext('/test_name/S1:label')"/>
      <itemset nodeset="instance('list')/root/item">
        <value ref="name"/>
        <label ref="jr:itext(itextId)"/>
      </itemset>
    </select1>
  </h:body>
</h:html>
