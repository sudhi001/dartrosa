<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <test_name id="data">
          <A/>
          <B1/>
          <C1/>
          <D1/>
          <E1/>
          <F1/>
          <G1/>
          <H1/>
          <I1/>
          <J1/>
          <meta>
            <instanceID/>
          </meta>
        </test_name>
      </instance>
      <bind nodeset="/test_name/A" type="string"/>
      <bind nodeset="/test_name/B1" type="string"/>
      <bind nodeset="/test_name/C1" type="string"/>
      <bind nodeset="/test_name/D1" type="string"/>
      <bind nodeset="/test_name/E1" type="string"/>
      <bind nodeset="/test_name/F1" type="string"/>
      <bind nodeset="/test_name/G1" type="string"/>
      <bind nodeset="/test_name/H1" type="string"/>
      <bind nodeset="/test_name/I1" type="string"/>
      <bind nodeset="/test_name/J1" type="string"/>
      <bind nodeset="/test_name/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/test_name/A">
      <label>None</label>
    </input>
    <input ref="/test_name/B1">
      <label> Before <output value=" /test_name/B1 "/> </label>
    </input>
    <input ref="/test_name/C1">
      <label><output value=" /test_name/B1 "/> After </label>
    </input>
    <input ref="/test_name/D1">
      <label> Before x2 <output value=" /test_name/B1 "/> <output value=" /test_name/B1 "/> </label>
    </input>
    <input ref="/test_name/E1">
      <label><output value=" /test_name/B1 "/> <output value=" /test_name/B1 "/> After x2 </label>
    </input>
    <input ref="/test_name/F1">
      <label><output value=" /test_name/B1 "/> Between <output value=" /test_name/B1 "/> </label>
    </input>
    <input ref="/test_name/G1">
      <label> Wrap <output value=" /test_name/B1 "/> in text </label>
    </input>
    <input ref="/test_name/H1">
      <label> Wrap <output value=" /test_name/B1 "/> in <output value=" /test_name/B1 "/> text </label>
    </input>
    <input ref="/test_name/I1">
      <label> Wrap <output value=" /test_name/B1 "/> in <output value=" /test_name/B1 "/> </label>
    </input>
    <input ref="/test_name/J1">
      <label> Encode <output value=" /test_name/B1 "/> &lt; <output value=" /test_name/B1 "/> </label>
    </input>
  </h:body>
</h:html>
