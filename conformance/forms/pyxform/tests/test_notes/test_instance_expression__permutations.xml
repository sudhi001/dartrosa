<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <test_name id="data">
          <q1/>
          <q2/>
          <text/>
          <note/>
          <meta>
            <instanceID/>
          </meta>
        </test_name>
      </instance>
      <instance id="c1">
        <root>
          <item>
            <name>y</name>
            <label>Yes</label>
          </item>
          <item>
            <name>n</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="c2">
        <root>
          <item>
            <name>b</name>
            <label>Big</label>
          </item>
          <item>
            <name>s</name>
            <label>Small</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/test_name/q1" type="string"/>
      <bind nodeset="/test_name/q2" type="string"/>
      <bind nodeset="/test_name/text" type="string"/>
      <bind nodeset="/test_name/note" readonly="true()" type="string"/>
      <bind nodeset="/test_name/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <select1 ref="/test_name/q1">
      <label>Q1</label>
      <itemset nodeset="instance('c1')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select1>
    <select1 ref="/test_name/q2">
      <label>Q2</label>
      <itemset nodeset="instance('c2')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select1>
    <input ref="/test_name/text">
      <label>Text</label>
    </input>
    <input ref="/test_name/note">
      <label> Text <output value=" /test_name/text "/> <output value="instance('c1')/root/item[name =  /test_name/q1 ]/label"/> <output value="instance(&quot;c1&quot;)/root/item[name =  /test_name/q1 ]/label"/> <output value="instance('c2')/root/item[contains(name,  /test_name/q2 )]/label"/> <output value="instance(&quot;c2&quot;)/root/item[contains(&quot;name&quot;,  /test_name/q2 )]/label"/> <output value="instance('c2')/root/item[contains(&quot;name&quot;,  /test_name/q2 )]/label"/> <output value="instance('c2')/root/item[contains(name, instance('c1')/root/item[name =  /test_name/q1 ]/label)]/label"/> <output value="instance(&quot;c2&quot;)/root/item[contains(name, instance(&quot;c1&quot;)/root/item[name =  /test_name/q1 ]/label)]/label"/> <output value="instance('c2')/root/item[contains(name, instance(&quot;c1&quot;)/root/item[name =  /test_name/q1 ]/label)]/label"/> <output value="instance('c1')/root/item[name = 'y']/label"/> <output value="instance(&quot;c1&quot;)/root/item[name = &quot;y&quot;]/label"/> <output value="instance(&quot;c1&quot;)/root/item[name = 'y']/label"/> <output value="instance(&quot;c1&quot;)/root/item[name &amp;lt;&amp;gt; 1 and &quot;&amp;lt;&amp;gt;&amp;amp;&quot; = &quot;1&quot;]/label"/> text </label>
    </input>
  </h:body>
</h:html>
