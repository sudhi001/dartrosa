<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="default" default="true()">
          <text id="/data/text:jr:constraintMsg">
            <value> too short <output value=" /data/foo "/> </value>
          </text>
        </translation>
      </itext>
      <instance>
        <data id="data">
          <foo/>
          <text/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/foo" type="int"/>
      <bind nodeset="/data/text" type="string" constraint="string-length(.) &gt; 1" jr:constraintMsg="jr:itext('/data/text:jr:constraintMsg')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/foo">
      <label>foo</label>
    </input>
    <input ref="/data/text">
      <label>text</label>
    </input>
  </h:body>
</h:html>
