<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <meta_audit id="data">
          <meta>
            <audit/>
            <instanceID/>
          </meta>
        </meta_audit>
      </instance>
      <bind nodeset="/meta_audit/meta/audit" type="binary" odk:track-changes="true" odk:location-max-age="300" odk:location-min-interval="60" odk:location-priority="balanced"/>
      <bind nodeset="/meta_audit/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body/>
</h:html>
