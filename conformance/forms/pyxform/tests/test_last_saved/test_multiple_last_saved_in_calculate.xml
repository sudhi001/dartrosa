<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <last-saved id="data">
          <foo/>
          <bar/>
          <last-sum/>
          <meta>
            <instanceID/>
          </meta>
        </last-saved>
      </instance>
      <instance id="__last-saved" src="jr://instance/last-saved"/>
      <bind nodeset="/last-saved/foo" type="int"/>
      <bind nodeset="/last-saved/bar" type="int"/>
      <bind nodeset="/last-saved/last-sum" type="string" calculate=" instance('__last-saved')/last-saved/foo  +  instance('__last-saved')/last-saved/bar "/>
      <bind nodeset="/last-saved/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/last-saved/foo">
      <label>Foo</label>
    </input>
    <input ref="/last-saved/bar">
      <label>Bar</label>
    </input>
  </h:body>
</h:html>
