<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <test_name id="data">
          <aa/>
          <section jr:template="">
            <a/>
            <b/>
            <c/>
            <d/>
          </section>
          <section>
            <a/>
            <b/>
            <c/>
            <d/>
          </section>
          <repeat_a jr:template="">
            <repeat_b jr:template="">
              <e/>
              <repeat_c jr:template="">
                <f/>
              </repeat_c>
            </repeat_b>
            <g/>
            <repeat_d jr:template="">
              <h/>
            </repeat_d>
            <i/>
          </repeat_a>
          <repeat_a>
            <repeat_b>
              <e/>
              <repeat_c>
                <f/>
              </repeat_c>
            </repeat_b>
            <g/>
            <repeat_d>
              <h/>
            </repeat_d>
            <i/>
          </repeat_a>
          <meta>
            <instanceID/>
          </meta>
        </test_name>
      </instance>
      <bind nodeset="/test_name/aa" type="string"/>
      <bind nodeset="/test_name/section/a" type="string"/>
      <bind nodeset="/test_name/section/b" type="string"/>
      <bind nodeset="/test_name/section/c" type="string"/>
      <bind nodeset="/test_name/section/d" readonly="true()" type="string"/>
      <bind nodeset="/test_name/repeat_a/repeat_b/e" type="string"/>
      <bind nodeset="/test_name/repeat_a/repeat_b/repeat_c/f" type="string"/>
      <bind nodeset="/test_name/repeat_a/g" type="string"/>
      <bind nodeset="/test_name/repeat_a/repeat_d/h" readonly="true()" type="string"/>
      <bind nodeset="/test_name/repeat_a/i" readonly="true()" type="string"/>
      <bind nodeset="/test_name/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/test_name/aa">
      <label>Text AA</label>
    </input>
    <group ref="/test_name/section">
      <label>Section</label>
      <repeat nodeset="/test_name/section">
        <input ref="/test_name/section/a">
          <label>Text A</label>
        </input>
        <input ref="/test_name/section/b">
          <label>Text B</label>
        </input>
        <input ref="/test_name/section/c">
          <label>Text C</label>
        </input>
        <input ref="/test_name/section/d">
          <label>Note D</label>
        </input>
      </repeat>
    </group>
    <group ref="/test_name/repeat_a">
      <label>Section A</label>
      <repeat nodeset="/test_name/repeat_a">
        <group ref="/test_name/repeat_a/repeat_b">
          <label>Section B</label>
          <repeat nodeset="/test_name/repeat_a/repeat_b">
            <input ref="/test_name/repeat_a/repeat_b/e">
              <label>Text E</label>
            </input>
            <group ref="/test_name/repeat_a/repeat_b/repeat_c">
              <label>Section C</label>
              <repeat nodeset="/test_name/repeat_a/repeat_b/repeat_c">
                <input ref="/test_name/repeat_a/repeat_b/repeat_c/f">
                  <label>Text F</label>
                </input>
              </repeat>
            </group>
          </repeat>
        </group>
        <input ref="/test_name/repeat_a/g">
          <label>Text G</label>
        </input>
        <group ref="/test_name/repeat_a/repeat_d">
          <label>Section D</label>
          <repeat nodeset="/test_name/repeat_a/repeat_d">
            <input ref="/test_name/repeat_a/repeat_d/h">
              <label>Note H</label>
            </input>
          </repeat>
        </group>
        <input ref="/test_name/repeat_a/i">
          <label>Note I</label>
        </input>
      </repeat>
    </group>
  </h:body>
</h:html>
