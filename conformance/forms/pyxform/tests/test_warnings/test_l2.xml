<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="default" default="true()">
          <text id="/img_test/display_img_test:label">
            <value form="image">jr://images/img_test.jpg</value>
          </text>
        </translation>
      </itext>
      <instance>
        <img_test id="data">
          <display_img_test/>
          <meta>
            <instanceID/>
          </meta>
        </img_test>
      </instance>
      <bind nodeset="/img_test/display_img_test" readonly="true()" type="string"/>
      <bind nodeset="/img_test/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/img_test/display_img_test">
      <label ref="jr:itext('/img_test/display_img_test:label')"/>
    </input>
  </h:body>
</h:html>
