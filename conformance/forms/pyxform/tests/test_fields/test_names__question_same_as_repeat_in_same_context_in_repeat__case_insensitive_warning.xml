<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>data</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <test_name id="data">
          <r1 jr:template="">
            <q1/>
            <Q1 jr:template="">
              <q2/>
            </Q1>
          </r1>
          <r1>
            <q1/>
            <Q1>
              <q2/>
            </Q1>
          </r1>
          <meta>
            <instanceID/>
          </meta>
        </test_name>
      </instance>
      <bind nodeset="/test_name/r1/q1" type="string"/>
      <bind nodeset="/test_name/r1/Q1/q2" type="string"/>
      <bind nodeset="/test_name/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group ref="/test_name/r1">
      <label>R1</label>
      <repeat nodeset="/test_name/r1">
        <input ref="/test_name/r1/q1">
          <label>Q1</label>
        </input>
        <group ref="/test_name/r1/Q1">
          <label>G2</label>
          <repeat nodeset="/test_name/r1/Q1">
            <input ref="/test_name/r1/Q1/q2">
              <label>Q2</label>
            </input>
          </repeat>
        </group>
      </repeat>
    </group>
  </h:body>
</h:html>
