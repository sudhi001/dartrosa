<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>field-list</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="default" default="true()">
          <text id="yes_no-0">
            <value>Yes</value>
          </text>
          <text id="yes_no-1">
            <value>No</value>
          </text>
          <text id="/data/name/table_list_question:label">
            <value>-</value>
          </text>
        </translation>
        <translation lang="chinese">
          <text id="yes_no-0">
            <value>是</value>
          </text>
          <text id="yes_no-1">
            <value>没有</value>
          </text>
          <text id="/data/name/table_list_question:label">
            <value>-</value>
          </text>
        </translation>
        <translation lang="english">
          <text id="/data/name/table_list_question:label">
            <value>table list question</value>
          </text>
          <text id="yes_no-0">
            <value>-</value>
          </text>
          <text id="yes_no-1">
            <value>-</value>
          </text>
        </translation>
      </itext>
      <instance>
        <data id="field-list">
          <name>
            <table_list_question/>
          </name>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="yes_no">
        <root>
          <item>
            <itextId>yes_no-0</itextId>
            <name>yes</name>
          </item>
          <item>
            <itextId>yes_no-1</itextId>
            <name>no</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/name/table_list_question" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group ref="/data/name">
      <select1 ref="/data/name/table_list_question">
        <label ref="jr:itext('/data/name/table_list_question:label')"/>
        <hint>hint</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
  </h:body>
</h:html>
